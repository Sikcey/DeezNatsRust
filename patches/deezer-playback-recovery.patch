+package audio
+
+import (
+	"context"
+	"errors"
+	"io"
+	"sync/atomic"
+	"time"
+)
+
+const streamReadIdleTimeout = 5 * time.Second
+
+var errStreamReadIdle = errors.New("audio stream stopped delivering data")
+
+// No whole-track deadline: long streams and paused/preloaded sources are valid.
+// Cancellation unblocks the net/http read without starting a goroutine per read.
+type idleStreamBody struct {
+	io.ReadCloser
+	cancel  context.CancelFunc
+	timeout time.Duration
+	stalled atomic.Bool
+}
+
+func (b *idleStreamBody) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if b.stalled.Load() {
+		return 0, errStreamReadIdle
+	}
+	timer := time.AfterFunc(b.timeout, func() {
+		b.stalled.Store(true)
+		b.cancel()
+	})
+	n, err := b.ReadCloser.Read(p)
+	timer.Stop()
+	if b.stalled.Load() {
+		return n, errStreamReadIdle
+	}
+	return n, err
+}
+
+func (b *idleStreamBody) Close() error {
+	b.cancel()
+	return b.ReadCloser.Close()
+}
