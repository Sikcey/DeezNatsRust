+package audio
+
+import (
+	"bytes"
+	"math"
+	"testing"
+
+	"github.com/Cycl0o0/OpenDeezer/v3/internal/deezer"
+)
+
+func starvationPlayer(t *testing.T) (*Player, *source) {
+	t.Helper()
+	p := &Player{out: &mockOutput{}}
+	p.setVolume(1)
+	p.sleepGain.Store(math.Float64bits(1))
+	s := newSource(&deezer.StreamPlan{Format: "MP3"}, 30000)
+	t.Cleanup(s.kill)
+	p.cur.Store(s)
+	p.state.Store(int32(Playing))
+	return p, s
+}
+
+func TestStarvationWaitsForReserveAndPreservesPCM(t *testing.T) {
+	p, s := starvationPlayer(t)
+	out := make([]byte, bytesPerSec/50) // a normal 20ms device callback
+	if p.readPCM(out) != 0 {
+		t.Fatal("expected initial starvation")
+	}
+	// Emulate a connection recovering in tiny bursts. The previous callback
+	// consumed each burst immediately, producing repeated audible gaps.
+	chunk := bytes.Repeat([]byte{0x12, 0x23, 0x34, 0x45}, len(out)/frameBytes)
+	for i := 0; i < 49; i++ {
+		s.ring.write(chunk, s.ring.seq())
+		if p.readPCM(out) != 0 {
+			t.Fatalf("consumed insufficient reserve at burst %d", i)
+		}
+		if !bytes.Equal(out, make([]byte, len(out))) {
+			t.Fatal("buffering leaked audio")
+		}
+	}
+	if p.PositionMS() != 0 || s.ring.buffered() != 49*len(chunk) {
+		t.Fatal("buffering advanced or lost PCM")
+	}
+	s.ring.write(chunk, s.ring.seq())
+	if n := p.readPCM(out); n != len(out) {
+		t.Fatalf("did not resume: %d", n)
+	}
+	// Only the initial anti-click ramp differs from the original PCM.
+	if !bytes.Equal(out[fadeInFrames*frameBytes:], chunk[fadeInFrames*frameBytes:]) {
+		t.Fatal("recovery changed PCM")
+	}
+	for i := 1; i < 50; i++ {
+		if p.readPCM(out) != len(out) || !bytes.Equal(out, chunk) {
+			t.Fatalf("lost/reordered PCM at callback %d", i)
+		}
+	}
+	if p.PositionMS() != 1000 || p.cbRebuffers.Load() != 1 {
+		t.Fatal("incorrect position or repeated recovery")
+	}
+}
+
+func TestStarvationEOFTailDoesNotWaitForFullReserve(t *testing.T) {
+	p, s := starvationPlayer(t)
+	out := make([]byte, 4096)
+	p.readPCM(out)
+	s.ring.write(bytes.Repeat([]byte{1, 2, 3, 4}, 100), s.ring.seq())
+	s.eof.Store(true)
+	if n := p.readPCM(out); n != 400 {
+		t.Fatalf("EOF tail stranded: %d", n)
+	}
+	if p.readPCM(out) != 0 || s.rebuffering.Load() {
+		t.Fatal("EOF triggered another recovery")
+	}
+}
+
+func TestStarvationPauseResumeRetainsReserveGate(t *testing.T) {
+	p, s := starvationPlayer(t)
+	out := make([]byte, 4096)
+	p.readPCM(out)
+	p.Pause()
+	if p.State() != Paused {
+		t.Fatal("could not pause while buffering")
+	}
+	s.ring.write(make([]byte, 8192), s.ring.seq())
+	p.Resume()
+	if p.State() != Playing || p.readPCM(out) != 0 || s.ring.buffered() != 8192 {
+		t.Fatal("resume bypassed reserve gate")
+	}
+	s.ring.write(make([]byte, bytesPerSec), s.ring.seq())
+	if p.readPCM(out) != len(out) {
+		t.Fatal("resume failed after reserve filled")
+	}
+}
+
+func TestStarvationDoesNotHoldReplacementSource(t *testing.T) {
+	p, old := starvationPlayer(t)
+	out := make([]byte, 4096)
+	p.readPCM(out)
+	p.Stop()
+	if !old.dead.Load() {
+		t.Fatal("stop retained starved source")
+	}
+	next := newSource(&deezer.StreamPlan{Format: "MP3"}, 30000)
+	t.Cleanup(next.kill)
+	next.ring.write(make([]byte, len(out)), next.ring.seq())
+	p.cur.Store(next)
+	p.state.Store(int32(Playing))
+	if p.readPCM(out) != len(out) {
+		t.Fatal("previous recovery leaked to replacement")
+	}
+}
+
+func TestStarvationSeekWaitsForNewPCM(t *testing.T) {
+	p, s := starvationPlayer(t)
+	out := make([]byte, 4096)
+	p.readPCM(out)
+	p.SeekMS(5000)
+	s.ring.write(make([]byte, bytesPerSec), s.ring.seq())
+	if p.readPCM(out) != 0 {
+		t.Fatal("consumed PCM before seek completed")
+	}
+	s.seekTo.Store(-1) // decoder publishes completion after refreshing its ring
+	if p.readPCM(out) != len(out) {
+		t.Fatal("seek recovery failed")
+	}
+	if p.PositionMS() < 5000 {
+		t.Fatal("seek position reset")
+	}
+}
