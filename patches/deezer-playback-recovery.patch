+package audio
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Cycl0o0/OpenDeezer/v3/internal/deezer"
+)
+
+type cancelBlockedBody struct{ ctx context.Context }
+
+func (b cancelBlockedBody) Read([]byte) (int, error) { <-b.ctx.Done(); return 0, b.ctx.Err() }
+func (b cancelBlockedBody) Close() error             { return nil }
+
+func TestStreamIdleCancelsBlockedReadWithoutKillingSource(t *testing.T) {
+	parent, stop := context.WithCancel(context.Background())
+	defer stop()
+	ctx, cancel := context.WithCancel(parent)
+	body := &idleStreamBody{ReadCloser: cancelBlockedBody{ctx}, cancel: cancel, timeout: 20 * time.Millisecond}
+	defer body.Close()
+	if _, err := body.Read(make([]byte, 100)); !errors.Is(err, errStreamReadIdle) {
+		t.Fatalf("read: %v", err)
+	}
+	if parent.Err() != nil {
+		t.Fatal("idle timeout cancelled entire source, preventing resume")
+	}
+}
+
+func TestStreamIdleDoesNotTimeBackpressure(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	body := &idleStreamBody{ReadCloser: io.NopCloser(bytes.NewReader([]byte("abcdef"))), cancel: cancel, timeout: 10 * time.Millisecond}
+	defer body.Close()
+	buf := make([]byte, 3)
+	if _, err := io.ReadFull(body, buf); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(40 * time.Millisecond) // preload gate / paused decoder, not a network read
+	if ctx.Err() != nil {
+		t.Fatal("backpressure expired the request")
+	}
+	if _, err := io.ReadFull(body, buf); err != nil || string(buf) != "def" {
+		t.Fatalf("resume after backpressure: %q %v", buf, err)
+	}
+	body.Close()
+	if ctx.Err() == nil {
+		t.Fatal("Close did not release request context")
+	}
+}
+
+// A CDN can leave TCP open indefinitely without returning an error. Verify
+// actual net/http cancellation and the production encrypted Range-resume path,
+// including the non-aligned decryption offset and exact final byte sequence.
+func TestStreamIdleDownloadResumesStalledEncryptedBody(t *testing.T) {
+	const trackID = "3135556"
+	cipher := make([]byte, 180003)
+	for i := range cipher {
+		cipher[i] = byte((i*7 + 3) % 251)
+	}
+	want, err := deezer.DecryptTrack(trackID, cipher)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if r.Header.Get("Range") != "" {
+			start := parseRangeStart(t, r.Header.Get("Range"))
+			if start == 0 || start >= len(cipher) {
+				t.Errorf("invalid resume offset %d", start)
+				return
+			}
+			w.Header().Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, len(cipher)-1, len(cipher)))
+			w.Header().Set("Content-Length", strconv.Itoa(len(cipher)-start))
+			w.WriteHeader(http.StatusPartialContent)
+			w.Write(cipher[start:])
+			return
+		}
+		w.Header().Set("Content-Length", strconv.Itoa(len(cipher)))
+		w.Write(cipher[:90001])
+		w.(http.Flusher).Flush()
+		<-r.Context().Done() // stays connected until the read-idle deadline cancels it
+	}))
+	defer server.Close()
+	s := newSource(&deezer.StreamPlan{CDNURL: server.URL, TrackID: trackID, Format: "MP3_320", Encrypted: true}, 30000)
+	defer s.kill()
+	done := make(chan struct{})
+	go func() { s.download(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(streamReadIdleTimeout + 5*time.Second):
+		s.kill()
+		t.Fatal("stalled download did not recover")
+	}
+	if requests.Load() != 2 {
+		t.Fatalf("requests=%d, want exactly one Range resume", requests.Load())
+	}
+	if s.lastErr() != "" {
+		t.Fatalf("download failed: %s", s.lastErr())
+	}
+	if got := drainStreamBuffer(s.sb); !bytes.Equal(got, want) {
+		t.Fatalf("resumed audio corrupt: got %d bytes, want %d", len(got), len(want))
+	}
+}
